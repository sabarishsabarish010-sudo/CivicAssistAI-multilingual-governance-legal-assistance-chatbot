APP_NAME=CivicAssist AI
APP_VERSION=1.0.0
DEBUG=True

HOST=127.0.0.1
PORT=8001

# Gemini API
# Paste your Gemini API key here.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Mapbox token for Nearby Services + map display.
MAPBOX_ACCESS_TOKEN=
DATABASE_URL=sqlite:///./civicassist.db

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

TAVILY_PROVIDER=tavily
TAVILY_API_KEY=
VECTOR_DB_DIR=vector_db
VECTOR_COLLECTION_NAME=civicassist

MYSCHEME_URL=https://www.myscheme.gov.in/
DATA_GOV_URL=https://www.data.gov.in/
INDIA_CODE_URL=https://www.indiacode.nic.in/

SECRET_KEY=change-this-to-a-random-secret-key








